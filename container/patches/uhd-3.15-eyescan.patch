+    // Diagnostic eye scan of the FPGA<->AD936x sample interface.  For every
+    // relative clock/data delay on the RX side (reg 0x006) and on the TX side
+    // (reg 0x007) it loops complementary I/Q patterns through the codec and
+    // reports, per data bit, whether the word came back in the right phase.
+    // Delay index d in [-15,15]: d>=0 -> data delayed d steps, d<0 -> clock
+    // delayed -d steps.  Output lines: EYE <rxd> <txd> <U> <L>, one char per
+    // bit 11..0: '.' right phase, 'x' other phase, '~' unstable.
+    void eyescan(std::function<void(uint32_t)> poker_functor,
+        std::function<uint64_t()> peeker_functor)
+    {
+        const char* rate_env = std::getenv("UHD_AD936X_EYESCAN_RATE");
+        if (rate_env) {
+            const double r = _codec_ctrl->set_clock_rate(std::atof(rate_env));
+            std::printf("EYERATE %.6f\n", r);
+            _codec_ctrl->data_port_loopback(true);
+            std::this_thread::sleep_for(std::chrono::milliseconds(5));
+        }
+        static const uint32_t pat[] = {0xAAA, 0x555, 0xFFF, 0x000, 0xF0F, 0x0F0};
+        const size_t npat = sizeof(pat) / sizeof(pat[0]);
+        const int reads   = 2;
+        auto reg = [](int d) -> uint8_t {
+            return d >= 0 ? uint8_t(d & 0xF) : uint8_t(((-d) & 0xF) << 4);
+        };
+        const char* only = std::getenv("UHD_AD936X_EYESCAN"); // "2d" or "cross"
+        const bool full  = only && std::string(only) == "2d";
+        for (int rxd = -15; rxd <= 15; rxd++) {
+            for (int txd = -15; txd <= 15; txd++) {
+                if (!full && rxd != 15 && txd != 15)
+                    continue;
+                _codec_ctrl->set_interface_delays(reg(rxd), reg(txd));
+                std::this_thread::sleep_for(std::chrono::microseconds(200));
+                int okU[12] = {0}, okL[12] = {0};
+                bool txbad = false;
+                for (size_t p = 0; p < npat; p++) {
+                    const uint32_t i12 = pat[p], q12 = (~pat[p]) & 0xFFF;
+                    const uint32_t w = (i12 << 20) | (q12 << 4);
+                    poker_functor(w);
+                    for (int k = 0; k < reads; k++) {
+                        const uint64_t rb = peeker_functor();
+                        if (uint32_t(rb >> 32) != w)
+                            txbad = true;
+                        const uint32_t rx = uint32_t(rb & 0xffffffff);
+                        const uint32_t u = (rx >> 20) & 0xFFF, l = (rx >> 4) & 0xFFF;
+                        for (int b = 0; b < 12; b++) {
+                            okU[b] += (((u ^ i12) >> b) & 1) ? 0 : 1;
+                            okL[b] += (((l ^ q12) >> b) & 1) ? 0 : 1;
+                        }
+                    }
+                }
+                const int tot = int(npat) * reads;
+                char su[13], sl[13];
+                for (int b = 0; b < 12; b++) {
+                    su[11 - b] = okU[b] == tot ? '.' : (okU[b] == 0 ? 'x' : '~');
+                    sl[11 - b] = okL[b] == tot ? '.' : (okL[b] == 0 ? 'x' : '~');
+                }
+                su[12] = sl[12] = 0;
+                std::printf("EYE %3d %3d %s %s%s\n", rxd, txd, su, sl,
+                    txbad ? " TXRB_BAD" : "");
+            }
+        }
+        std::fflush(stdout);
+        _codec_ctrl->set_interface_delays(0x0F, 0x0F);
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
