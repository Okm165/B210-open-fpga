/*.jou
/*.vcd
/*.fst
/*.lxt
/*.lxt2
/*.wdb
/*.pb
/*.str
/*.history
/abc.history

# Simulation and waveform artifacts anywhere.
*.vcd
*.fst
*.lxt
*.lxt2
*.gtkwave
*.wdb
*.wcfg

# Local toolchains, Python environments, and editor state.
/.tools/
/.venv/
/.opencode/
/.context/
/.cache/
/.idea/
/.vscode/
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# Python bytecode and test caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Temporary downloads and fragments.
*.tmp
*.part
