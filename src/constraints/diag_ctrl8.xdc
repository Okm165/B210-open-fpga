# diag_ctrl.xdc - clocks, the full GPIF pin set, and LEDs.
create_clock -period 25.000 -name codec_main_clk_p [get_ports codec_main_clk_p]
create_clock -period 10.000 -name ifclk_in [get_ports IFCLK]
set_property LOC AA17 [get_ports codec_main_clk_p]
set_property IOSTANDARD LVDS [get_ports codec_main_clk_p]
set_property LOC AA18 [get_ports codec_main_clk_n]
set_property IOSTANDARD LVDS [get_ports codec_main_clk_n]
set_property LOC F9 [get_ports LED_CLK_G]
set_property IOSTANDARD LVCMOS33 [get_ports LED_CLK_G]
set_property LOC E13 [get_ports LED_RX1]
set_property IOSTANDARD LVCMOS33 [get_ports LED_RX1]
set_property LOC B11 [get_ports LED_STATUS]
set_property LOC AD1 [get_ports IFCLK]
set_property IOSTANDARD LVCMOS18 [get_ports IFCLK]
set_property DRIVE 16 [get_ports IFCLK]
set_property SLEW FAST [get_ports IFCLK]
#   set_output_delay -clock IFCLK -max 2.0 [get_ports {GPIF_D[*]}]
#   set_output_delay -clock IFCLK -min 0.0 [get_ports {GPIF_D[*]}]
#   set_input_delay  -clock IFCLK -max 8.0 [get_ports {GPIF_D[*] GPIF_CTL*}]
#   set_input_delay  -clock IFCLK -min 2.0 [get_ports {GPIF_D[*]}]
set_property LOC U6 [get_ports {GPIF_D[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports {GPIF_D[0]}]
