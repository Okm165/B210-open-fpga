# Vendor-matching electrical constraints (SLEW SLOW on the whole
# FX3 P-port, as in the genuine b210.xdc).
set_property SLEW SLOW [get_ports GPIF_D[0]]
set_property SLEW SLOW [get_ports GPIF_D[1]]
set_property SLEW SLOW [get_ports GPIF_D[2]]
